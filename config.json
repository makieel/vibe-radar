  "arxivMax": 200,
  "trackDays": 30,
  "ai": {
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "keyEnv": "GEMINI_API_KEY",
    "models": ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite", "gemini-3.6-flash", "gemini-3.8-flash", "gemini-2.5-flash"],
    "timeoutMs": 150000
  }
}
